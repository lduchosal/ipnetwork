<Project>
  <PropertyGroup>
    <!-- The one version of the whole solution. Package, assembly and file versions all derive from it,
         a release overrides it with /p:Version=<tag>, and versionize bumps it here. -->
    <Version>5.0.1</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Some SDK distributions (Homebrew among them) ship ILCompiler and ILLink.Tasks in a local
         library-packs feed whose packages hash differently from nuget.org. Restoring from it writes
         hashes into packages.lock.json that CI cannot match (NU1403), so always restore from the feeds. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>
</Project>